# Copy to a root-readable deployment env file. Never commit real secrets.
UNIVERSE_REPO_DIR=/srv/ops/repos/UniverseSimulation
UNIVERSE_UPLOADS_DIR=/srv/ops/universe_rag/uploads
UNIVERSE_API_PORT=8103
UNIVERSE_RAG_RUNTIME_IMAGE=docker-rag_innovasjon_api

UNIVERSE_POSTGRES_USER=rag
UNIVERSE_POSTGRES_PASSWORD=replace-with-random-secret
UNIVERSE_POSTGRES_DB=rag_universe

UNIVERSE_LLM_PROVIDER=openai_compat
UNIVERSE_LLM_BASE_URL=https://api.openai.com/v1
UNIVERSE_LLM_API_KEY=replace-with-provider-key
UNIVERSE_LLM_MODEL=gpt-4o-mini

UNIVERSE_ADMIN_API_KEY=replace-with-random-secret
UNIVERSE_RESEARCH_API_TOKENS_JSON={"replace-with-random-token":{"label":"server-smoke","scopes":["research:read"],"case_ids":["universe_project","universe_tools","universe_argumentation","universe_prompts"]}}
UNIVERSE_RESEARCH_DOWNLOAD_SIGNING_KEY=replace-with-random-secret

UNIVERSE_RESEARCH_RATE_LIMIT_PER_MINUTE=30
UNIVERSE_RESEARCH_RATE_LIMIT_BURST=60
UNIVERSE_RESEARCH_FRESHNESS_MAX_AGE_SECONDS=86400
